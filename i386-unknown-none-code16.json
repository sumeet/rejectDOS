{
  "llvm-target": "i386-unknown-none-elf",
  "data-layout": "e-m:e-p:16:16-i32:32-i64:64-f80:32-n8:16-S32",
  "arch": "x86",
  "target-pointer-width": 16,
  "target-endian": "little",
  "target-c-int-width": 16,
  "os": "none",
  "env": "none",
  "vendor": "unknown",
  "linker-flavor": "ld.lld",
  "executables": true,
  "panic-strategy": "abort",
  "features": "+code16,-mmx,-sse,-sse2,-sse3,-ssse3,-sse4.1,-sse4.2,-avx,-avx2,-avx512f,-avx512vl,-avx512dq,-avx512bw,-fma,-f16c",
  "relocation-model": "static",
  "code-model": "small"
}
